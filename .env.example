# Port the Node app listens on
PORT=3000

# Public URL of the site (used for share links / CORS)
PUBLIC_ORIGIN=https://example.com

# Set to "production" on the server
NODE_ENV=production

# Comma separated list of allowed origins for Socket.IO ("*" allows all)
CORS_ORIGIN=*

# ---------------------------------------------------------------
# Multi-domain (mirrors)
# ---------------------------------------------------------------
# All of these domains point at THIS server. Rooms are shared across them,
# so a visitor can use whichever domain is reachable from their network.
# PUBLIC_DOMAINS=film.example.com,watch.example.ir,bmb.example.net

# Optional soft per-country preference (COUNTRY=domain, comma separated).
# Only a *suggestion* — the browser still verifies what is actually reachable.
# DOMAIN_HINTS=IR=watch.example.ir,DE=film.example.com

# Max users per room
MAX_ROOM_USERS=50

# ---------------------------------------------------------------
# Video / voice calls (WebRTC mesh) — phase 2
# ---------------------------------------------------------------
# Every participant uploads one stream per other participant, so bandwidth
# grows with N². Measured at ~600 kbps per outgoing stream:
#   4 people -> 1.8 Mbps up (works on a normal Iranian mobile connection)
#   5 people -> 2.4 Mbps up (starts breaking up)
# Raise it only if your users are all on fibre.
MAX_CALL_PEERS=4

# --- ICE / NAT traversal ---------------------------------------
# STUN alone gets ~85-90% of peers connected and needs no configuration.
# The remaining users (symmetric NAT, carrier-grade NAT, strict mobile
# networks) need a TURN relay. This server cannot host one: it sits behind
# the boxd proxy, which does not expose the UDP ports TURN requires
# (3478, 5349 and the 49152-65535 relay range).
#
# So point these at an EXTERNAL TURN provider whenever you get one — the
# app reads them at runtime and serves them from /api/ice, no code change.
# Multiple entries are comma separated.
#
# Prefer turns: on port 443 — it looks like ordinary HTTPS traffic and is
# the variant that survives aggressive filtering.
#
# STUN_URL=stun:stun.cloudflare.com:3478
# TURN_URL=turns:relay.example.com:443?transport=tcp,turn:relay.example.com:3478
# TURN_USER=myuser
# TURN_PASS=mysecret
#
# One username/password is reused for every TURN_URL. To mix providers,
# pass matching comma-separated lists:
# TURN_URL=turns:a.example:443,turns:b.example:443
# TURN_USER=userA,userB
# TURN_PASS=passA,passB

# DANGER: allow the media proxy to reach private/internal addresses
# (127.0.0.1, 10.x, 192.168.x …). Only enable if you stream from a
# self-hosted server on the same machine/LAN — it turns the proxy into
# an SSRF gateway to your internal network. Leave unset in production.
# ALLOW_PRIVATE_MEDIA_HOSTS=1
